# Frontend environment template.
#
#     cp .env.example .env
#
# Every variable here is compiled into the JavaScript bundle and readable by anyone who
# opens dev tools. Clerk's *publishable* key belongs here; its secret key does not, and
# neither does a database URL, a webhook secret, or anything else the backend holds. Vite
# only exposes names beginning with VITE_, which is a guardrail, not a guarantee — the
# rule is about what the value is, not what it is called.
#
# All of these are optional except the Clerk key: the app renders a configuration notice
# rather than a blank screen when it is missing.

# Clerk publishable key, from the Clerk dashboard under API Keys.
# Begins with pk_test_ in development and pk_live_ in production.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the API. Leave empty for same-origin, which is the intended setup:
# requests go to /api/v1/... and are resolved by the Vite dev proxy in development, or by
# whatever reverse proxy serves the built assets in production. Set it only when the API
# is genuinely on another origin, and expect to configure CORS_ORIGINS on the backend to
# match. There is deliberately no localhost default compiled into the bundle.
VITE_API_BASE_URL=

# Display formatting. These two want to agree with each other; a currency of INR with a
# locale of en-US will render symbols and separators from different conventions.
VITE_CURRENCY=INR
VITE_LOCALE=en-IN

# Where the dev server forwards proxied API requests. Dev-server only: it is read by
# vite.config.js and never reaches the bundle, which is why it has no VITE_ meaning here
# beyond the naming convention. Override it when the backend runs on another port or
# inside a container.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
