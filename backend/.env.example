# Example environment for the CBPA backend.
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. This file is not — so it must never contain a real
# credential. Every value below is a placeholder or a safe default.
#
# ---------------------------------------------------------------------------
# SECURITY NOTICE
#
# Earlier revisions of this file committed a live Clerk secret key, a live Clerk
# issuer and a Supabase connection string with its password inline. Those values
# are in the git history and must be treated as compromised:
#
#   1. Rotate the Clerk secret key in the Clerk dashboard (API Keys → regenerate).
#   2. Rotate the Supabase database password (Project Settings → Database).
#   3. Update your local `.env` with the new values.
#
# Rotating is the fix, not deleting these lines — anyone with the repository can
# read the old commit.
# ---------------------------------------------------------------------------


# ===========================================================================
# Core application
# ===========================================================================

APP_NAME=Customer Buying Pattern Analysis API

# `production` turns on stricter defaults: health endpoints stop naming the hosts
# they probe, and the log format assumes a collector is reading it.
APP_ENV=development

# Comma-separated browser origins allowed to call the API. Add your deployed
# frontend origin here; do not use `*` with credentialed requests.
# Kept identical to the default in app/config.py. When the two drift, the
# behaviour a developer gets from `cp .env.example .env` differs from the one
# they get without a .env at all, and only one of them matches the docs.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# `json` for machine-readable structured logs, `console` for readable local output.
LOG_LEVEL=INFO
LOG_FORMAT=json

API_VERSION=v1


# ===========================================================================
# Database — PostgreSQL / Supabase. The source of truth.
# ===========================================================================
#
# Supabase gives you this string under Project Settings → Database → Connection
# string. Use the connection *pooler* host for a serverless or short-lived
# process; use the direct host for migrations.
#
# The password must be percent-encoded. A password containing `@` becomes `%40`,
# `#` becomes `%23`, `/` becomes `%2F` — otherwise the URL parser reads your
# password as the hostname and the failure message is unhelpfully vague.
#
# Leaving this unset is supported: the app starts, the health check reports the
# database as unconfigured, and anything tenant-scoped returns an error rather
# than silently pretending to have data.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---------------------------------------------------------------------------
# Connection pool and query ceilings
# ---------------------------------------------------------------------------
#
# The defaults below are correct for Supabase over the public internet and only
# need touching if you change where the database lives. They are documented
# because every one of them is a bound on a way the API can appear dead.
#
# DB_POOL_TIMEOUT_SECONDS is the one that matters most: with no bound, a request
# that cannot get a connection waits forever, so a busy backend is
# indistinguishable from a crashed one. Ten seconds turns that into a 503 the
# caller can act on.
#
# DB_POOL_RECYCLE_SECONDS must stay below the interval at which Supabase's pooler
# drops idle connections. A connection the server has already closed surfaces as
# a mid-request failure; recycling first means the client discards it instead.

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=900

# Enforced by PostgreSQL itself, which is the only kind of timeout that can stop
# work already running inside the driver — a Python-side timeout abandons the
# *wait*, not the query, because a thread blocked in a C extension cannot be
# interrupted. Imports issue long batched INSERTs, so they get a separate, larger
# ceiling applied per session rather than raising the global default for everyone.

DB_STATEMENT_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=10
DB_IMPORT_STATEMENT_TIMEOUT_SECONDS=120


# ===========================================================================
# Imports — concurrency, batching and size limits
# ===========================================================================
#
# CSV parsing and the database writes it feeds are synchronous, so they run in a
# worker thread rather than on the event loop. IMPORT_MAX_CONCURRENCY is what
# stops that becoming a different outage: unbounded offload lets N simultaneous
# uploads each check out connections, exhaust the pool and starve every read.
# Keep it at or below DB_POOL_SIZE so each import worker can still get one.
#
# IMPORT_TIMEOUT_SECONDS sits below nginx's proxy_read_timeout (300s in
# frontend/nginx.conf) on purpose, so a stuck import produces an API error the UI
# can display rather than a 504 from the proxy with no detail in it.
#
# IMPORT_BATCH_SIZE is rows per flush. Large enough that round-trips amortise,
# small enough that one batch's parameter list stays inside PostgreSQL's ceiling
# of 65,535 bind parameters per statement — the code clamps it to a safe value,
# so raising this wildly is bounded rather than fatal, but it will stop helping.
#
# IMPORT_MAX_ROWS answers "how much memory does an import need" in configuration
# rather than leaving the answer to whoever uploads the file.

IMPORT_MAX_CONCURRENCY=4
IMPORT_TIMEOUT_SECONDS=240.0
PREVIEW_TIMEOUT_SECONDS=30.0
IMPORT_BATCH_SIZE=1000
IMPORT_MAX_ROWS=500000


# ===========================================================================
# Authentication — Clerk
# ===========================================================================
#
# The secret key is server-side only and must never reach the browser bundle.
# The frontend needs the *publishable* key instead, set in `frontend/.env` as
# VITE_CLERK_PUBLISHABLE_KEY.
#
# CLERK_ISSUER is your Frontend API URL (Clerk dashboard → API Keys). Tokens are
# verified against its JWKS endpoint, so it must match the instance that issued
# them or every request fails with a 401.

CLERK_SECRET_KEY= yes
CLERK_ISSUER= yes


# ===========================================================================
# Redis cache — optional
# ===========================================================================
#
# A cache, never the source of truth. With REDIS_ENABLED=false the app runs
# normally and every read goes to PostgreSQL; nothing is unavailable, some
# dashboard queries are just slower.
#
# CACHE_LOCAL_FALLBACK keeps a small bounded in-process dict so the caching code
# path is still exercised in development. It is per-process and dies with the
# worker, which is fine for a cache and would not be fine for anything else.
#
# Cache keys are namespaced by business id, so one tenant can never read
# another's cached values.

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
CACHE_LOCAL_FALLBACK=true

CACHE_DEFAULT_TTL_SECONDS=300
CACHE_DASHBOARD_TTL_SECONDS=120
CACHE_ANALYTICS_TTL_SECONDS=600
CACHE_JOB_TTL_SECONDS=3600


# ===========================================================================
# Kafka event bus — optional
# ===========================================================================
#
# An event bus, never the source of truth. With KAFKA_ENABLED=false, publishes
# become no-ops and EVENTS_INLINE_FALLBACK makes analytics jobs run inline in the
# request instead: the API contract is unchanged (you still get a job id and a
# status to poll) but the work happens synchronously, so a large refresh will
# hold the request open.
#
# `docker compose up -d` in the repository root starts Kafka in KRaft mode on
# localhost:9092 with no Zookeeper.
#
# KAFKA_TOPIC_PREFIX namespaces topics so several environments can share one
# broker — set it to something like `staging.` and topics become
# `staging.customers.events`.

KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=cbpa-api
KAFKA_CONSUMER_GROUP=cbpa-workers
KAFKA_TOPIC_PREFIX=
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=1.0
EVENTS_INLINE_FALLBACK=true

# Bounds on how long the API will wait for the broker. Publishing happens on the
# request path, so an unreachable broker without these is a hung endpoint rather
# than a degraded one.
#
# KAFKA_PUBLISH_TIMEOUT_SECONDS covers the whole retry loop, not one attempt: a
# per-attempt timeout multiplied by KAFKA_MAX_RETRIES is not a bound on the
# operation. Keep it above KAFKA_REQUEST_TIMEOUT_MS or the outer ceiling fires
# before a single attempt can finish.
#
# KAFKA_STARTUP_TIMEOUT_SECONDS bounds the connect at boot, so a broker that is
# down degrades to "events disabled" instead of stopping the API from serving
# anything at all.

KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_PUBLISH_TIMEOUT_SECONDS=15.0
KAFKA_STARTUP_TIMEOUT_SECONDS=20.0

# PLAINTEXT for the local Docker broker. A managed broker (Confluent Cloud, MSK,
# Aiven) will want SASL_SSL plus the three SASL values below.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=


# ===========================================================================
# Webhook ingestion
# ===========================================================================
#
# WEBHOOK_SECRET is the shared HMAC-SHA256 signing key. Generate one with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Give it to the sender out of band. It is never returned by any endpoint and
# never written to a log.
#
# With WEBHOOK_REQUIRE_SIGNATURE=true and no secret set, every delivery is
# rejected — which is the safe failure. Setting it to false accepts unsigned
# deliveries and is for local development only: it means anyone who can reach the
# endpoint can write to a tenant's data.
#
# WEBHOOK_TOLERANCE_SECONDS bounds how old a signed timestamp may be. This is
# what stops a captured request being replayed tomorrow; 300 seconds allows for
# ordinary clock skew between two servers.

WEBHOOK_SECRET=
WEBHOOK_REQUIRE_SIGNATURE=true
WEBHOOK_TOLERANCE_SECONDS=300

WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
WEBHOOK_EVENT_ID_HEADER=X-Webhook-Event-Id
WEBHOOK_BUSINESS_HEADER=X-Business-Id


# ===========================================================================
# Analytics
# ===========================================================================

MODEL_VERSION=v1

# Queue an RFM refresh automatically when an import finishes, so the dashboard
# does not keep showing figures computed before the new orders arrived. Turn off
# for bulk backfills, where one refresh at the end beats one per file.
ANALYTICS_AUTO_REFRESH_ON_IMPORT=true

# Units on hand at or below which a product counts as low stock. The dashboard,
# the inventory summary and the inventory page all read this one value, so
# changing it here changes all three together.
INVENTORY_LOW_STOCK_THRESHOLD=10


# ===========================================================================
# Phase 1 compatibility
# ===========================================================================
#
# `memory` keeps the legacy upload/analyse flow's intermediate artefacts in the
# process. The Phase 2 import pipeline writes to PostgreSQL regardless of this.

STORAGE_BACKEND=memory
# PREPROCESSING_OUTPUT_DIR=./preprocessing_outputs


# ===========================================================================
# Diagnostics
# ===========================================================================
#
# Whether /health/ready may name the host:port it is probing. A hostname is not a
# credential, but on an unauthenticated endpoint it is still reconnaissance, so
# this defaults to off when APP_ENV is production. Any userinfo is stripped
# server-side before the value is returned either way.

EXPOSE_HEALTH_TARGETS=true
